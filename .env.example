# Non-sensitive template. scripts/bootstrap-control-plane.sh generates the real .env (mode 0600).
# Never commit .env. Values marked <generated> are random secrets created on the host.
POSTGRES_PASSWORD=<generated>
REDIS_PASSWORD=<generated>
# kid:base64(32 bytes)[,older_kid:...] - first key encrypts, all keys decrypt (rotation)
UDEPLOY_MASTER_KEYS=<generated by: udeploy-admin gen-master-key>
UDEPLOY_PUBLIC_BASE_URL=https://deploy.example.com
UDEPLOY_AGENT_API_URL=https://deploy.example.com:8443
UDEPLOY_RESERVED_HOSTS=["deploy.example.com"]
UDEPLOY_AGENT_API_BIND=0.0.0.0
UDEPLOY_LOG_JSON=true
# Optional tuning (defaults shown)
# UDEPLOY_AGENT_LEASE_SECONDS=60
# UDEPLOY_AGENT_OFFLINE_AFTER_SECONDS=90
# UDEPLOY_TASK_MAX_ATTEMPTS=3
# UDEPLOY_RELEASE_VERIFY_MAX_RETRIES=6
# UDEPLOY_WEBHOOK_MAX_BODY_BYTES=1048576
# UDEPLOY_DOCS_ENABLED=true
